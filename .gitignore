# Generated/runtime noise
.venv/
*.egg-info/
**/__pycache__/
# Quarto site render output (the _freeze cache IS committed; _site is not)
site/_site/
site/.quarto/
*.py[cod]
.pytest_cache/
.Rhistory
.RData
.Rproj.user/
.DS_Store
Thumbs.db

# PNG and CSV outputs are the canonical checked artifacts; omit duplicate PDFs.
analysis/output/**/*.pdf

# Local clinical-row inputs are never part of the public Workbench bundle.
app/workbench/data/sample_train.csv
train.impute.csv
test.impute.csv

# Private, duplicated, or uncleared working artifacts. These remain local
# until their public-release boundary is explicitly resolved.
paper/
docs/_archive_*/
docs/APP.md
docs/LUMAWARP_EXPLAIN_GUIDE.md
docs/workbench_mockup.html
analysis/output/lumawarp_v1/
